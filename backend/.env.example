# Copy to .env and fill in — or set these in your host's dashboard.
# DEVELOPMENT template (permissive). For production use
# .env.production.example — with SP_ENV=production the backend refuses
# to start on insecure settings (wildcard hosts/CORS, DEBUG, weak secret
# key, insecure cookies). See PRODUCTION-READINESS.md §6.
DJANGO_SECRET_KEY=
DEBUG=0
CORS_ALLOW_ALL=1
CORS_ALLOWED_ORIGINS=
RESEND_API_KEY=
EMAIL_TO=info@sportingpearlsacademy.org
EMAIL_FROM=info@sportingpearlsacademy.org
AUTO_REPLY=1
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=
DJANGO_SUPERUSER_EMAIL=info@sportingpearlsacademy.org
RATE_LIMIT_PER_MINUTE=8
TIME_ZONE=Africa/Nairobi
# Phase 2 — set 1 ONLY when a trusted front (nginx / Railway / Render)
# terminates TLS in front of the backend; install.sh --with-nginx does
# it automatically. Leave 0 when gunicorn is exposed directly.
TRUST_PROXY_HEADER=0
# Safeguarding (form 10): the DSO's PRIVATE inbox. New reports send a
# minimal "a report is waiting" notification here — never to EMAIL_TO.
# Leave empty to disable notifications (reports stay in /portal/dso/).
#DSO_EMAIL=safeguarding@example.com
# Phase 5 — optional PostgreSQL + shared cache (defaults: SQLite +
# per-process cache; leave both unset on the standard single-host kit).
# PostgreSQL needs the driver first:  pip install "psycopg[binary]"
#DB_ENGINE=postgres
#DB_NAME=sporting_pearls
#DB_USER=sporting
#DB_PASSWORD=
#DB_HOST=127.0.0.1
#DB_PORT=5432
# Shared throttle counters across gunicorn workers (needs PostgreSQL;
# one-time setup after switching):  python manage.py createcachetable
#SP_CACHE=db
# Phase 7 — public website origin, used for QR code targets on the
# printable player cards (written automatically by install.sh; QR cards
# point at  SITE_URL/player.html?ref=XXXX). No trailing slash.
#SITE_URL=http://localhost:8090
