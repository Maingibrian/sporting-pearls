# ════════════════════════════════════════════════════════════════════
#  SPORTING PEARLS — PRODUCTION ENVIRONMENT TEMPLATE (no credentials)
#
#  Copy to backend/.env on the production host and fill every <…> slot.
#  NOTHING in this file is a secret — real secrets are generated per host:
#
#    DJANGO_SECRET_KEY   python3 -c "import secrets;print(secrets.token_urlsafe(48))"
#    RESEND_API_KEY      from the Resend dashboard (resend.com/api-keys)
#    staff password      install.sh  --admin pass via SP_ADMIN_PASS env, or a
#                        random one generated and shown once at install
#
#  With SP_ENV=production the backend REFUSES TO START (fail closed) if
#  any of these hold: DEBUG=1 · ALLOWED_HOSTS empty or * · CORS_ALLOW_ALL=1
#  · DJANGO_SECRET_KEY missing/known-insecure/shorter than 50 chars
#  · SESSION_COOKIE_SECURE=0 · CSRF_COOKIE_SECURE=0.
#  See PRODUCTION-READINESS.md §6.
# ════════════════════════════════════════════════════════════════════

# ── Operating mode ────────────────────────────────────────────────────
SP_ENV=production

# ── Django core (all five are guarded in production mode) ─────────────
# Generate per host:  python3 -c "import secrets;print(secrets.token_urlsafe(48))"
DJANGO_SECRET_KEY=<generate-a-64-char-random-key-per-host>
DEBUG=0
# Real domain only — no wildcards, no LAN IPs in production.
ALLOWED_HOSTS=<your.domain>,www.<your.domain>
# Cookies only over HTTPS.
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# ── CORS / CSRF — the origin(s) the static site is served from ────────
CORS_ALLOW_ALL=0
CORS_ALLOWED_ORIGINS=https://<your.domain>,https://www.<your.domain>
CSRF_TRUSTED_ORIGINS=https://<your.domain>,https://www.<your.domain>

# ── TLS ───────────────────────────────────────────────────────────────
# Set once certificates are live (install.sh --with-tls does this).
SECURE_SSL_REDIRECT=1

# ── Phase 2: proxy trust + session/auth knobs ───────────────────────
# 1 ONLY when a trusted front (nginx, Railway, Render) terminates TLS
# and forwards X-Forwarded-Proto; leave 0 when gunicorn is exposed
# directly, or clients could spoof "I am HTTPS". install.sh --with-nginx
# writes this automatically.
TRUST_PROXY_HEADER=1
# Portal sessions die after this many seconds of age (default 12h).
#SESSION_COOKIE_AGE=43200
# Password-reset links expire after this many seconds (default 1h).
#PASSWORD_RESET_TIMEOUT=3600
# HSTS from the app itself — only for direct-HTTPS hosts WITHOUT the
# nginx front (the nginx --with-tls front already sends HSTS site-wide).
#SECURE_HSTS_SECONDS=31536000

# ── Email (Resend) — off until the key is set ─────────────────────────
RESEND_API_KEY=<from-resend-dashboard-or-leave-empty-to-disable-mail>
EMAIL_TO=<academy-office-inbox>
EMAIL_FROM=<verified-sender-on-your-resend-domain>
AUTO_REPLY=1
# DEMO/QC ONLY — leave empty in production (redirects all outbound mail):
SP_MAIL_REDIRECT=

# ── Safeguarding (Phase 1) ────────────────────────────────────────────
# The Designated Safeguarding Officer's PRIVATE inbox. New form-10
# reports send a minimal "a report is waiting in the DSO desk"
# notification here — NEVER the narrative or any personal data, and
# NEVER the general academy inbox (EMAIL_TO). Leave empty to disable
# notifications (reports remain visible only inside /portal/dso/).
DSO_EMAIL=<dso-private-inbox-or-empty>

# ── Website origin (portal sign-in "user guide" links; empty hides) ────
SITE_URL=https://<your.domain>

# ── Storage ───────────────────────────────────────────────────────────
# Keep the database and uploads on a backed-up volume, not the OS disk.
DB_PATH=<absolute-path-on-a-backed-up-volume>/db.sqlite3
MEDIA_ROOT=<absolute-path-on-a-backed-up-volume>/media

# ── Network binding ───────────────────────────────────────────────────
# Behind the nginx front the backend only needs the loopback:
SP_BIND=127.0.0.1
SP_PORT_API=8020
SP_PORT_SITE=8090

# ── Policy knobs ──────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=8
TIME_ZONE=Africa/Nairobi

# ── Phase 5: optional PostgreSQL + shared cache ──────────────────────
# Defaults (SQLite + per-process cache) suit the standard single-host
# kit. Move to PostgreSQL when you need concurrent writers and throttle
# counters shared across gunicorn workers. Driver first:
#   pip install "psycopg[binary]"
# Then set:
#DB_ENGINE=postgres
#DB_NAME=sporting_pearls
#DB_USER=sporting
#DB_PASSWORD=<strong-db-password>
#DB_HOST=127.0.0.1
#DB_PORT=5432
# Shared cache (recommended with PostgreSQL; one-time setup after
# switching):  python manage.py createcachetable
#SP_CACHE=db
